# SSEService env example
# Port the HTTP server listens on
PORT=8084
# Service name in logs
SERVICE_NAME=SSEService
# Log level: debug|info|warn|error
LOG_LEVEL=info
# Colorize JSON logs: true/false
LOG_COLOR=true
# JWT secret (currently unused by SSEService, reserved for future auth). Keep >=32 chars.
JWT_SECRET=change_me_32_plus_chars_secret_ABCDEFG123456