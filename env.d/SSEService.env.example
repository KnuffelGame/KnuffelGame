# SSEService env example

# Basic service settings
PORT=8084
SERVICE_NAME=SSEService
# Log level: debug|info|warn|error
LOG_LEVEL=info
# Colorize JSON logs: true/false
LOG_COLOR=false

# CORS configuration (CSV lists)
# Example origins: http://localhost:5173,http://localhost:8080
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Accept,Authorization,Content-Type,X-Requested-With
CORS_ALLOW_CREDENTIALS=true

# Rate limiting (requests per minute per IP)
# Internal endpoints: reasonable limit
RATE_LIMIT_INTERNAL_PER_MINUTE=60
# SSE endpoints: 0 disables rate limiting (recommended for long-lived connections)
RATE_LIMIT_SSE_PER_MINUTE=0

# JWT cookie name (used by clients for auth; validation added in later subtasks)
JWT_COOKIE_NAME=jwt

# Internal token to protect /internal endpoints (REQUIRED in production)
# Set to a strong random string and share only within internal services
SSE_INTERNAL_TOKEN=change_me_strong_random_token

# Heartbeat interval for SSE keep-alive (milliseconds)
HEARTBEAT_INTERVAL_MS=30000

# API Gateway base URL (for future authorizer calls)
# Example: http://localhost:8081
APIGATEWAY_BASE_URL=